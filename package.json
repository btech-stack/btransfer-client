{
  "name": "btransfer-client",
  "version": "0.3.0",
  "description": "End-to-end versleuteld bestanden versturen via BTransfer. De sleutel verlaat je apparaat alleen in de link.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btech-stack/btransfer-client.git"
  },
  "homepage": "https://docs.btransfer.nl",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
